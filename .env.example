# Copy this file to .env and fill it in. Never commit .env. It is already in .gitignore.

# Your own Claude API key from platform.claude.com. Use a key with a low spend limit.
ANTHROPIC_API_KEY=

# Who approves the drafts, and how replies are signed
OWNER_NAME=Your name
SIGNATURE=Your name, Your Company
COMPANY_NAME=Your Company

# Where hot-lead alerts go (only written into your local n8n file, never committed)
ALERT_EMAIL=you@example.com
# Set to minimal to keep names and messages out of the alert email (they stay in HubSpot)
ALERT_DETAILS=minimal

# Your company context file. Start from context/template.md.
CONTEXT_FILE=context/example-bycn-studios.md

# Your website: only this address may send forms to the Lead Loop's webhook
SITE_ORIGIN=https://yourdomain.com
# WEBHOOK_PATH is made and saved here by scripts/build.py the first time you run it

# Weekly overview (see docs/weekly-overview-setup.md)
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE=sc-domain:yourdomain.com
NOTION_DATABASE_ID=
# Use https://app-eu1.hubspot.com if your HubSpot account is in the EU
HUBSPOT_APP_URL=https://app.hubspot.com
TIMEZONE=Europe/Oslo

# Demand Engine
EVIDENCE_FILE=demand-engine/evidence/my-evidence.md
BRAND_NAMES=Your Company,yourdomain.com
# Optional: Queries.csv from Search Console (Performance, Export), so the SEO agent works from real searches
SEARCH_CONSOLE_FILE=
# Optional: outputs from the Audit and Reporting agents
AUDIT_FILE=
REPORT_FILE=
